[generic]
###########################
# Max CPU frequency sets
little_cpu_max_freq="2508"

###########################
# Available CPU governors
# conservative ondemand userspace powersave interactive performance schedutil
little_cpu_governor="performance"

###########################
# Max GPU frequency sets
# 852 666 500 400 285
gpu_max_freq="852"

###########################
# Available GPU governors
# dmc_ondemand venc_ondemand userspace powersave performance simple_ondemand
gpu_governor="performance"

###########################
# Display rotation
display_orientation="0"

overlays="ir i2c0 i2c1 spi0 uart1"
overlays_resize=16384

###########################
# Disable VU7
# disable_vu7="true"

###########################
# flipped touch screen x,y
# touch_flip_x="false"
# touch_flip_y="false"

###########################
# test mt screen
# test_mt_vid="0000"
# test_mt_pid="0000"

###########################
# Prevent sleep
# prevent_sleep="true"

###########################
# set hdmi output mode as DVI. (video only)
# voutmode="dvi"

###########################
# Disable hot plug detection when HDMI plug is unplugged
# disablehpd="true"

###########################
# force hot plug detect on boot sequence
force_hpd="false"

user_def_args="quiet"
